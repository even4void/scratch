Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"arrival", "=", 
   RowBox[{
    RowBox[{"RandomChoice", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "150"}], "]"}], "*", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"20", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", "150"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9990553771649446`*^9, 3.9990553771649637`*^9}},
