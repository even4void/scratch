Notebook[{
Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"https", ":"}], "//", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"tali", ".", "link"}], "/", "posts"}], "/", "random"}], "-", 
    RowBox[{"walks", "/"}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{4.002085273229163*^9, 
  4.002085276357525*^9}},ExpressionUUID->"4fc9e965-b181-4814-abf6-\
7060280f6f4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RandomWalk", "[", "timesteps_", "]"}], ":=", 
   RowBox[{"FoldList", "[", 
    RowBox[{"Plus", ",", "0", ",", 
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], ",", 
       "timesteps"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002085132931285*^9, 4.002085133905155*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"e5cd0697-4a95-4458-b206-ac9ce343e519"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"RandomWalk", "[", "500", "]"}], ",", 
   RowBox[{"PlotStyle", "->", "Blue"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalEAcute]tapes\>\"", ",", "\"\<Position\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Marche Al\[EAcute]atoire (1D)\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.002085140766926*^9, 4.002085140767*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"a7af6176-20e4-4d49-a36a-fb33aa7f6d29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Distribution", "[", 
    RowBox[{"length_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"width", "=", 
       RowBox[{"2.2", " ", 
        RowBox[{"Sqrt", "[", "length", "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BinCounts", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "width"}], ",", "width", ",", "1"}], "}"}]}], "]"}], 
       "&"}], "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomWalk", "[", "length", "]"}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{4.002084818271607*^9, 4.002084819241932*^9}, {
  4.002084850739303*^9, 4.002084851079268*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"b6d24902-1cd7-4ab7-b9c9-3d82e6ad791e"],

